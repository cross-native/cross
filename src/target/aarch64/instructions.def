// The instructions the AArch64 backend selects, in the order of the
// instructions that cpu entries cost: the enumerator, the mnemonic, and
// each form the backend emits as "OPERANDS | EFFECTS" in the spelling of
// instruction entries. Loading checks that the shipped instruction table
// defines them so and that no other model adds forms to them.
X(Add, "add",
  "rd:x, rn:x, rm:x, shift:shift64=0 | reads=rn,rm writes=rd",
  "rd:w, rn:w, rm:w, shift:shift32=0 | reads=rn,rm writes=rd",
  "rd:xsp, rn:xsp, imm:uimm12_lsl12 | reads=rn writes=rd",
  "rd:wsp, rn:wsp, imm:uimm12_lsl12 | reads=rn writes=rd")
X(Sub, "sub",
  "rd:x, rn:x, rm:x, shift:shift64=0 | reads=rn,rm writes=rd",
  "rd:w, rn:w, rm:w, shift:shift32=0 | reads=rn,rm writes=rd",
  "rd:xsp, rn:xsp, imm:uimm12_lsl12 | reads=rn writes=rd",
  "rd:wsp, rn:wsp, imm:uimm12_lsl12 | reads=rn writes=rd")
X(Neg, "neg",
  "rd:x, rm:x, shift:shift64=0 | reads=rm writes=rd",
  "rd:w, rm:w, shift:shift32=0 | reads=rm writes=rd")
X(Mul, "mul",
  "rd:x, rn:x, rm:x | reads=rn,rm writes=rd",
  "rd:w, rn:w, rm:w | reads=rn,rm writes=rd")
X(Madd, "madd",
  "rd:x, rn:x, rm:x, ra:x | reads=rn,rm,ra writes=rd",
  "rd:w, rn:w, rm:w, ra:w | reads=rn,rm,ra writes=rd")
X(Msub, "msub",
  "rd:x, rn:x, rm:x, ra:x | reads=rn,rm,ra writes=rd",
