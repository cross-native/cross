[[abi("@ABI@"), link_name("@PREFIX@branch"), noinline]]
global u64 benchmark_branch(in const u64 *data, in uptr count,
                            in uptr rounds) {
    u64 result = 1469598103934665603u64;
    uptr round = 0;
    u64 round_value = 0u64;
    while (round < rounds) {
        uptr index = 0;
        while (index < count) {
            u64 value = data[index] + round_value;
            if ((value & 1u64) != 0u64) {
                result = result + value * 3u64 + 1u64;
            } else {
                result = result ^ (value + 11400714819323198485u64);
            }
            index = index + 1;
        }
        round = round + 1;
        round_value = round_value + 1u64;
    }
    return result;
}

[[abi("@ABI@"), link_name("@PREFIX@classify"), noinline]]
global u64 benchmark_classify(in const u64 *data, in uptr count,
                              in uptr rounds) {
    u64 result = 0u64;
    u64 round_value = 0u64;
    uptr round = 0;
    while (round < rounds) {
        uptr index = 0;
        while (index < count) {
            u64 value = data[index] + round_value;
            u64 selector = value & 7u64;
            if (selector == 0u64) {
                result = result + value;
            } else if (selector == 1u64) {
                result = result ^ (value << 1);
            } else if (selector == 2u64) {
                result = result + value * 3u64;
            } else if (selector == 3u64) {
                result = result ^ (value >> 2);
            } else if (selector == 4u64) {
                result = result - value;
            } else if (selector == 5u64) {
                result = result + (value ^ 11400714819323198485u64);
            } else if (selector == 6u64) {
                result = result ^ (value * 5u64);
            } else {
                result = result + (value >> 3);
            }
            index = index + 1;
        }
        round_value = round_value + 1u64;
        round = round + 1;
    }
    return result;
}

[[abi("@ABI@"), link_name("@PREFIX@search"), noinline]]
global u64 benchmark_search(in const u64 *data, in uptr count,
                            in u64 seed, in uptr rounds) {
    u64 result = 0u64;
    u64 limit = count * 3u64;
    u64 target = seed % limit;
    uptr round = 0;
    while (round < rounds) {
        uptr low = 0;
        uptr high = count;
        while (low < high) {
            uptr middle = low + ((high - low) >> 1);
            if (data[middle] < target) {
                low = middle + 1;
            } else {
                high = middle;
            }
        }
        result = result + (low ^ target);
        target = target + 97u64;
        if (target >= limit) {
            target = target - limit;
        }
        round = round + 1;
    }
    return result;
}

[[abi("@ABI@"), link_name("@PREFIX@select"), noinline]]
global u64 benchmark_select(in const u64 *data, in uptr count,
                            in uptr rounds) {
    u64 result = 0u64;
    u64 round_value = 0u64;
    uptr round = 0;
    while (round < rounds) {
        uptr index = 0;
        while (index < count) {
            u64 value = data[index] + round_value;
            if (value < 9223372036854775808u64) {
                result = result + value * 5u64;
            } else {
                result = result + (value ^ 11400714819323198485u64);
            }
            index = index + 1;
        }
        round_value = round_value + 1u64;
        round = round + 1;
    }
    return result;
}

[[abi("@ABI@"), link_name("@PREFIX@clamp"), noinline]]
global u64 benchmark_clamp(in const u64 *data, in uptr count,
                           in uptr rounds) {
    u64 result = 0u64;
    u64 round_value = 0u64;
    uptr round = 0;
    while (round < rounds) {
        uptr index = 0;
        while (index < count) {
            u64 value = data[index] + round_value;
            u64 selected = value;
            if (selected < 4611686018427387904u64) {
                selected = 4611686018427387904u64;
            }
            if (selected > 13835058055282163711u64) {
                selected = 13835058055282163711u64;
            }
            result = result + (selected ^ index);
            index = index + 1;
        }
        round_value = round_value + 1u64;
        round = round + 1;
    }
    return result;
}

[[abi("@ABI@"), link_name("@PREFIX@linear_search"), noinline]]
global u64 benchmark_linear_search(in const u64 *data, in uptr count,
                                   in u64 seed, in uptr rounds) {
    u64 result = 0u64;
    u64 limit = count * 3u64;
    u64 target = seed % limit;
    uptr round = 0;
    while (round < rounds) {
        uptr index = 0;
        while (index < count && data[index] < target) {
            index = index + 1;
        }
        result = result + (index ^ target);
        target = target + 97u64;
        if (target >= limit) {
            target = target - limit;
        }
        round = round + 1;
    }
    return result;
}
