foreach(required CC SOURCE OUTPUT ARCH LEVEL)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "${required} must name a value")
    endif()
endforeach()
if(ARCH STREQUAL "mips")
    set(target -mprofile=vr4300-o32)
    set(below 18)
    set(above 22)
else()
    # The strict budget; the x86-64 profiles' CISC balance doubles it.
    set(target -target x86_64-unknown-linux-gnu -mrisc-cisc-balance=0)
    set(below 8)
    set(above 12)
endif()
function(compile mode)
    execute_process(COMMAND "${CC}" -emit-llvm -${LEVEL} -fno-eval-calls
        ${target} ${ARGN} "${SOURCE}" -o "${OUTPUT}.${mode}.ll"
        RESULT_VARIABLE status OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "${mode} failed\n${stdout}\n${stderr}")
    endif()
    file(READ "${OUTPUT}.${mode}.ll" ir)
    set(${mode} "${ir}" PARENT_SCOPE)
endfunction()
function(expect_unrolled ir symbol expected)
    string(REGEX MATCH "define[^\n]*@\"${symbol}\"[^}]*}" body "${ir}")
    if(NOT body)
        message(FATAL_ERROR "missing ${symbol}")
    endif()
    # The main loop's bound is rounded down to its factor; the ring has no
    # other bitwise AND. This inspects MIR without instruction-selection noise.
    if(body MATCHES "and i32" AND NOT expected)
        message(FATAL_ERROR "${symbol} exceeds its register bank but unrolled")
    elseif(NOT body MATCHES "and i32" AND expected)
        message(FATAL_ERROR "${symbol} fits its register bank but did not unroll")
    endif()
endfunction()
compile(budget)
compile(unlimited -fno-unroll-register-pressure)
compile(rolled -fno-unroll-loops)
expect_unrolled("${budget}" pressure_${below} TRUE)
expect_unrolled("${budget}" pressure_${above} FALSE)
expect_unrolled("${unlimited}" pressure_${above} TRUE)
expect_unrolled("${rolled}" pressure_${below} FALSE)
foreach(bank_count 8 14)
    if(bank_count EQUAL 8)
        set(expected TRUE)
    else()
        set(expected FALSE)
    endif()
    expect_unrolled("${budget}" pressure_float_${bank_count} ${expected})
    expect_unrolled("${unlimited}" pressure_float_${bank_count} TRUE)
endforeach()
compile(preset "--model=${SOURCE}m" -O=pressure_off)
expect_unrolled("${preset}" pressure_${above} TRUE)
# Explicit controls override a named preset, regardless of their order.
compile(override -funroll-register-pressure "--model=${SOURCE}m" -O=pressure_off)
expect_unrolled("${override}" pressure_${above} FALSE)
if(NOT ARCH STREQUAL "mips")
    compile(cisc -mrisc-cisc-balance=100)
    expect_unrolled("${cisc}" pressure_${above} TRUE)
    expect_unrolled("${cisc}" pressure_float_14 TRUE)
endif()
if(ARCH STREQUAL "mips")
    # The Cross ABI carries values in t0-t3, withholding those scratch colors.
    compile(cross_abi -mabi=x32)
    expect_unrolled("${cross_abi}" pressure_18 FALSE)
endif()
