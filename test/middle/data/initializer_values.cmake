# Static images of initializers that start from a value, in both byte orders:
# the parts of a base that no entry replaces, with their relocations, and the
# zero padding and union bytes around the replaced parts.
foreach(required CC SOURCE OUTPUT)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "${required} must name a path")
    endif()
endforeach()

# The data directives of `object`, one per list element.
function(data assembly object result)
    string(FIND "${assembly}" "\n${object}:\n" start)
    if(start EQUAL -1)
        message(FATAL_ERROR "no object ${object}")
    endif()
    string(LENGTH "\n${object}:\n" skip)
    math(EXPR start "${start} + ${skip}")
    string(SUBSTRING "${assembly}" ${start} -1 rest)
    string(REGEX MATCH "^([ \t]*\\.(byte|short|long|quad)[^\n]*\n)+" lines "${rest}")
    string(REGEX REPLACE "(^|\n)[ \t]+" "\\1" lines "${lines}")
    string(REGEX REPLACE "[ \t]+" " " lines "${lines}")
    string(STRIP "${lines}" lines)
    string(REPLACE "\n" ";" lines "${lines}")
    set(${result} "${lines}" PARENT_SCOPE)
endfunction()

function(expect assembly target object expected)
    data("${assembly}" ${object} actual)
    if(NOT actual STREQUAL "${expected}")
        message(FATAL_ERROR "${target}: ${object} is '${actual}', expected '${expected}'")
    endif()
endfunction()

foreach(target x86-64 mips)
    if(target STREQUAL x86-64)
        set(flags -target x86_64-unknown-linux-gnu)
        set(address quad)
    else()
        set(flags -target mips-unknown-elf -march=r3000 -mabi=o32)
        set(address long)
    endif()
    execute_process(COMMAND "${CC}" ${flags} -S "${SOURCE}" -o "${OUTPUT}-${target}.s"
        RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "${target}: compilation failed\n${out}\n${err}")
    endif()
    file(READ "${OUTPUT}-${target}.s" assembly)

    # A derived record keeps the base's relocations it does not replace, and
    # a copied string address names the base's string object.
    data("${assembly}" hero hero)
    data("${assembly}" partner partner)
    data("${assembly}" heavy heavy)
    list(GET hero 0 hero_harm)
    list(GET hero 1 hero_push)
    list(GET hero 3 hero_name)
    if(NOT hero_harm MATCHES "^\\.${address} " OR NOT hero_name MATCHES "^\\.${address} ")
        message(FATAL_ERROR "${target}: hero lacks its relocations: '${hero}'")
    endif()
    list(GET partner 0 partner_harm)
    list(GET partner 1 partner_push)
    list(GET partner 3 partner_name)
    list(GET heavy 0 heavy_harm)
    list(GET heavy 1 heavy_push)
    list(GET heavy 3 heavy_name)
    if(partner_harm STREQUAL hero_harm OR NOT partner_push STREQUAL hero_push OR
       NOT partner_name STREQUAL hero_name OR NOT heavy_harm STREQUAL hero_harm OR
       NOT heavy_push STREQUAL hero_push OR NOT heavy_name STREQUAL hero_name)
        message(FATAL_ERROR "${target}: derived records\n  hero ${hero}\n  partner ${partner}\n  heavy ${heavy}")
    endif()
    expect("${assembly}" ${target} pk2 ".${address} k")
    expect("${assembly}" ${target} table_copy ".byte 17,17,34,34,119,119,68,68")
    expect("${assembly}" ${target} word ".byte 97,88,99,0,0,0")
    expect("${assembly}" ${target} entered ".byte 0,85,0,0,3,0,0,0")
    if(target STREQUAL x86-64)
        expect("${assembly}" ${target} hard ".byte 4,0,0,0,102,0,0,0,2,0,0,0")
        expect("${assembly}" ${target} reset ".byte 4,0,0,0,0,0,0,0,9,0,0,0")
        expect("${assembly}" ${target} kept ".byte 221,204,187,170,4,0,0,0")
        expect("${assembly}" ${target} flag_copy ".byte 29,68")
    else()
        expect("${assembly}" ${target} hard ".byte 0,4,0,0,0,0,0,102,0,0,0,2")
        expect("${assembly}" ${target} reset ".byte 0,4,0,0,0,0,0,0,0,0,0,9")
        expect("${assembly}" ${target} kept ".byte 170,187,204,221,4,0,0,0")
        expect("${assembly}" ${target} flag_copy ".byte 163,68")
    endif()
endforeach()
