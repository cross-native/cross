# Floating constant folding follows the profile environment, and constant
# folding, constant-object reads, memory value forwarding, conditional
# replacement, power-of-two division, and shared store addresses follow
# their controls on x86-64 and MIPS.

foreach(required CC SOURCE MODEL OUTPUT)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "${required} must name a path")
    endif()
endforeach()
file(MAKE_DIRECTORY "${OUTPUT}")

function(compile label)
    execute_process(COMMAND "${CC}" -S ${ARGN} "${SOURCE}"
                            -o "${OUTPUT}/${label}.s"
        RESULT_VARIABLE status OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "${label} failed to compile\n${stdout}\n${stderr}")
    endif()
    file(READ "${OUTPUT}/${label}.s" assembly)
    string(REPLACE ";" "," assembly "${assembly}")
    set(assembly "${assembly}" PARENT_SCOPE)
endfunction()

function(function_text result function)
    string(FIND "${assembly}" "\n${function}:\n" start)
    string(FIND "${assembly}" "\n.size ${function}," end)
    if(start EQUAL -1 OR end EQUAL -1)
        message(FATAL_ERROR "no function ${function} in\n${assembly}")
    endif()
    math(EXPR length "${end} - ${start}")
    string(SUBSTRING "${assembly}" ${start} ${length} text)
    set(${result} "${text}" PARENT_SCOPE)
endfunction()

# Whether `function` matches `pattern` as `present` says.
function(expect label function pattern present)
    function_text(text ${function})
    if(present AND NOT text MATCHES "${pattern}")
        message(FATAL_ERROR "${label}: ${function} lacks '${pattern}'\n${text}")
    elseif(NOT present AND text MATCHES "${pattern}")
        message(FATAL_ERROR "${label}: ${function} has '${pattern}'\n${text}")
    endif()
endfunction()

function(expect_count label function pattern count)
    function_text(text ${function})
    string(REGEX MATCHALL "${pattern}" matches "${text}")
    list(LENGTH matches found)
    if(NOT found EQUAL count)
        message(FATAL_ERROR
            "${label}: ${function} has ${found} '${pattern}', not ${count}\n${text}")
    endif()
endfunction()

set(x86 -target x86_64-unknown-linux-gnu)
compile(x86-O2 -O2 ${x86})
expect(x86-O2 reciprocal "\tdivss\t" FALSE)
expect(x86-O2 scaled "_scale[(]%rip[)]" FALSE)
expect_count(x86-O2 bump "\tmovl\tcounter[(]%rip[)], " 1)
expect(x86-O2 below "\t(cmov|j)[a-z]*\t" FALSE)
expect(x86-O2 eighth "\tmulss\t" TRUE)
expect(x86-O2 eighth "\tdivss\t" FALSE)
expect(x86-O2 second "\tmovl\t4[(]%" TRUE)
foreach(function overflow denormal_product tiny_product)
    expect(x86-O2 ${function} "\tmulss\t" FALSE)
endforeach()
expect(x86-O2 infinite "\tdivss\t" FALSE)
expect(x86-O2 read_replaceable "replaceable[(]%rip[)]" TRUE)
expect(x86-O2 read_zero_word "zero_word[(]%rip[)]" FALSE)
expect(x86-O2 constant_tag "constant_pair" FALSE)
compile(x86-zero-data -O2 -fzero-init-in-data ${x86})
expect(x86-zero-data read_zero_word "zero_word[(]%rip[)]" TRUE)
compile(x86-no-ccp -O2 -fno-tree-ccp ${x86})
expect(x86-no-ccp reciprocal "\tdivss\t" TRUE)
expect(x86-no-ccp scaled "_scale[(]%rip[)]" TRUE)
expect(x86-no-ccp below "\tcmov[a-z]*\t" TRUE)
expect(x86-no-ccp constant_tag "constant_pair" TRUE)
compile(x86-no-fre -O2 -fno-tree-fre ${x86})
expect_count(x86-no-fre bump "\tmovl\tcounter[(]%rip[)], " 2)
compile(x86-no-div -O2 -fno-div-by-constant ${x86})
expect(x86-no-div eighth "\tdivss\t" TRUE)

# An operation stays where the environment traps an exception it raises.
set(model "--model=${MODEL}")
compile(x86-range -O2 ${x86} ${model} -mprofile=range-trap-fp)
expect(x86-range overflow "\tmulss\t" TRUE)
expect(x86-range tiny_product "\tmulss\t" TRUE)
expect(x86-range reciprocal "\tdivss\t" FALSE)
compile(x86-divide -O2 ${x86} ${model} -mprofile=divide-trap-fp)
expect(x86-divide infinite "\tdivss\t" TRUE)
expect(x86-divide overflow "\tmulss\t" FALSE)
compile(x86-trapping -O2 ${x86} ${model} -mprofile=trapping-fp)
expect(x86-trapping denormal_product "\tmulss\t" TRUE)
expect(x86-trapping tiny_product "\tmulss\t" TRUE)
expect(x86-trapping overflow "\tmulss\t" FALSE)

set(mips -target mips-unknown-elf -march=vr4300 -mabi=o32)
compile(mips-O2 -O2 ${mips})
expect(mips-O2 reciprocal "\tdiv[.]s\t" FALSE)
expect(mips-O2 below "\tb[a-z]*\t" FALSE)
expect(mips-O2 refresh "\tsll\t" FALSE)
expect_count(mips-O2 bump "\tlw\t" 3)
expect(mips-O2 eighth "\tmul[.]s\t" TRUE)
compile(mips-no-ccp -O2 -fno-tree-ccp ${mips})
expect(mips-no-ccp below "\tb[a-z]*\t" TRUE)
compile(mips-no-fre -O2 -fno-tree-fre ${mips})
expect_count(mips-no-fre bump "\tlw\t" 5)
compile(mips-no-ivopts -O2 -fno-ivopts ${mips})
expect(mips-no-ivopts refresh "\tsll\t" TRUE)
compile(mips-no-div -O2 -fno-div-by-constant ${mips})
expect(mips-no-div eighth "\tdiv[.]s\t" TRUE)
compile(mips-trapping -O2 ${mips} ${model} -mprofile=trapping-fp)
expect(mips-trapping denormal_product "\tmul[.]s\t" TRUE)
expect(mips-trapping reciprocal "\tdiv[.]s\t" FALSE)
