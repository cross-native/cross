foreach(mode O2 O3 O2-avx2 O3-avx2 no-vectorize)
    string(REGEX MATCH "^O[0-9]" level "${mode}")
    if(NOT level)
        set(level O2)
    endif()
    set(flags -${level})
    if(mode MATCHES "avx2")
        list(APPEND flags -march=x86-64-v3)
    elseif(mode STREQUAL "no-vectorize")
        list(APPEND flags -fno-tree-loop-vectorize -fno-tree-slp-vectorize)
    endif()
    execute_process(COMMAND "${CC}" -S ${flags} -fno-eval-calls
        -target x86_64-unknown-linux-gnu "${SOURCE}" -o "${OUTPUT}-${mode}.s"
        RESULT_VARIABLE status ERROR_VARIABLE error)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "reduction compilation failed: ${error}")
    endif()
    file(READ "${OUTPUT}-${mode}.s" assembly)
    foreach(name dot dot_signed dot_uptr dot_iptr)
        string(FIND "${assembly}" "${name}:" start)
        string(SUBSTRING "${assembly}" ${start} -1 tail)
        string(FIND "${tail}" ".size ${name}," length)
        string(SUBSTRING "${tail}" 0 ${length} body)
        if(mode STREQUAL "no-vectorize")
            if(body MATCHES "%[xy]mm")
                message(FATAL_ERROR "vectorization ignored its control\n${body}")
            endif()
        elseif(mode MATCHES "avx2")
            if(NOT body MATCHES "vpmulld[^\n]*%ymm" OR NOT body MATCHES "imull")
                message(FATAL_ERROR "missing AVX2 loop or scalar remainder\n${body}")
            endif()
        elseif(NOT body MATCHES "pmuludq" OR NOT body MATCHES "imull")
            message(FATAL_ERROR "missing SSE2 loop or scalar remainder\n${body}")
        endif()
    endforeach()
endforeach()
