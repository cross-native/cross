function(compile name)
    execute_process(COMMAND "${CC}" -S -O2 -fwrapv -fno-eval-calls
        -fno-unroll-loops -fno-tree-loop-vectorize ${ARGN}
        "${SOURCE}" -o "${OUTPUT}-${name}.s"
        RESULT_VARIABLE status ERROR_VARIABLE error)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "${name}: ${error}")
    endif()
    file(READ "${OUTPUT}-${name}.s" assembly)
    set(assembly "${assembly}" PARENT_SCOPE)
endfunction()

function(body name)
    string(FIND "${assembly}" "\n${name}:" start)
    if(start LESS 0)
        message(FATAL_ERROR "missing function ${name}")
    endif()
    string(SUBSTRING "${assembly}" ${start} -1 text)
    string(FIND "${text}" "${terminator} ${name}" end)
    if(end LESS 0)
        message(FATAL_ERROR "missing end of ${name}")
    endif()
    string(SUBSTRING "${text}" 0 ${end} text)
    set(text "${text}" PARENT_SCOPE)
endfunction()

function(expect name pattern present)
    body(${name})
    if(present AND NOT text MATCHES "${pattern}")
        message(FATAL_ERROR "${name} lacks ${pattern}\n${text}")
    elseif(NOT present AND text MATCHES "${pattern}")
        message(FATAL_ERROR "${name} has ${pattern}\n${text}")
    endif()
endfunction()

# Check the dependency graph: either the independent add precedes the
# destructive shift, or it follows a shift of a copy without reading it.
function(expect_parallel name parallel)
    body(${name})
    set(balanced FALSE)
    string(REGEX MATCH
        "addl\t(%[a-z0-9]+), (%[a-z0-9]+)\n\tshll\t[$]5, (%[a-z0-9]+)\n\taddl\t(%[a-z0-9]+), (%[a-z0-9]+)"
        before "${text}")
    if(before)
        if(CMAKE_MATCH_1 STREQUAL CMAKE_MATCH_3 AND
           CMAKE_MATCH_2 STREQUAL CMAKE_MATCH_4 AND
           CMAKE_MATCH_3 STREQUAL CMAKE_MATCH_5 AND
           NOT CMAKE_MATCH_1 STREQUAL CMAKE_MATCH_2)
            set(balanced TRUE)
        endif()
    else()
        string(REGEX MATCH "shll\t[$]5, (%[a-z0-9]+)\n\taddl\t([^\n]+)"
            after "${text}")
        if(NOT after)
            message(FATAL_ERROR "${name}: missing shift/add sequence\n${text}")
        endif()
        set(shift_register "${CMAKE_MATCH_1}")
        set(first_add "${CMAKE_MATCH_2}")
        string(FIND "${first_add}" "${shift_register}" serial)
        if(serial LESS 0)
            set(balanced TRUE)
        endif()
    endif()
    if((parallel AND NOT balanced) OR (NOT parallel AND balanced))
        message(FATAL_ERROR "${name}: incorrect carried dependency\n${text}")
    endif()
endfunction()

if(ARCH STREQUAL "x86_64")
    set(target -target x86_64-unknown-linux-gnu)
    set(terminator .size)
    foreach(mode O2 O3 v3)
        set(flags)
        if(mode STREQUAL "O3")
            list(APPEND flags -O3)
        elseif(mode STREQUAL "v3")
            list(APPEND flags -march=x86-64-v3)
        endif()
        compile(${mode} ${target} ${flags})
        foreach(type u32 u64 i32)
            foreach(constant 31 33)
                expect(hash_${type}_${constant} "imul[lq]" FALSE)
                expect(hash_${type}_${constant} "shl[lq]" TRUE)
            endforeach()
            foreach(constant 65599 16777619)
                expect(hash_${type}_${constant} "imul[lq]" TRUE)
            endforeach()
        endforeach()
        expect_parallel(hash_u32_33 TRUE)
        expect_parallel(hash_i32_33 TRUE)
        expect_parallel(hash_shifted TRUE)
        expect(hash_u32_9 "leal" TRUE)
        expect(hash_u32_9 "shll" FALSE)
        expect(independent_product "imull\t[$]33" TRUE)
    endforeach()
    compile(no-reassoc ${target} -fno-tree-reassoc)
    expect(hash_u32_33 imull FALSE)
    expect_parallel(hash_u32_33 FALSE)
    expect_parallel(hash_shifted FALSE)
    compile(no-wrap ${target} -fno-wrapv)
    expect_parallel(hash_i32_33 FALSE)
    compile(no-slsr ${target} -fno-tree-slsr)
    expect(hash_u32_33 imull TRUE)
    expect_parallel(hash_shifted TRUE)
    foreach(mode fastmul slowshift slowadd)
        if(mode STREQUAL "fastmul")
            set(cost_model "${FAST_MODEL}")
        else()
            set(cost_model "${MODEL}")
        endif()
        compile(${mode} ${target} "--model=${cost_model}" -mtune=${mode})
        expect(hash_u32_33 "imull\t[$]33" TRUE)
        expect(hash_u64_33 "imulq\t[$]33" TRUE)
    endforeach()
    compile(slowsub ${target} "--model=${MODEL}" -mtune=slowsub)
    expect(hash_u32_31 "imull\t[$]31" TRUE)
    compile(slowmul ${target} "--model=${MODEL}" -mtune=slowmul)
    expect(hash_u32_65599 imull FALSE)
    expect(hash_u32_16777619 imull FALSE)
    expect(independent_product "imull\t[$]33" TRUE)
    compile(size ${target} -Os)
    expect(hash_u32_33 imull TRUE)
else()
    set(target -target mips-unknown-elf -march=vr4300 -mabi=o32)
    set(terminator .end)
    compile(vr4300 ${target})
    expect(hash_u32_33 "\tsll\t" TRUE)
    expect(hash_u32_33 "\tmultu?\t" FALSE)
    expect(hash_u32_65599 "\tmultu?\t" FALSE)
    expect(hash_u32_16777619 "\tmultu?\t" TRUE)
    compile(fastmul ${target} "--model=${FAST_MODEL}" -mtune=fastmul)
    expect(hash_u32_33 "\tmultu?\t" TRUE)
    expect(hash_u64_33 "\tdmultu?\t" TRUE)
endif()
