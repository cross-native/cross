# "-o -" and "-MF -" write text to standard output and create no file named
# "-"; an object file cannot go there. Files written beside the output take
# the names they would have without -o.

foreach(required CC CPP OUTPUT)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "${required} must name a path")
    endif()
endforeach()
file(REMOVE_RECURSE "${OUTPUT}")
file(MAKE_DIRECTORY "${OUTPUT}")
file(WRITE "${OUTPUT}/unit.x" "global i32 unit_value() { return 1; }\n")

function(run label expected)
    execute_process(COMMAND ${ARGN} WORKING_DIRECTORY "${OUTPUT}"
        RESULT_VARIABLE status OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
    if(NOT status EQUAL expected)
        message(FATAL_ERROR "${label}: status ${status}, expected ${expected}\n${stdout}\n${stderr}")
    endif()
    set(stdout "${stdout}" PARENT_SCOPE)
    set(stderr "${stderr}" PARENT_SCOPE)
endfunction()

set(target -target x86_64-unknown-linux-gnu)
run(assembly 0 "${CC}" -S ${target} unit.x -o -)
if(NOT stdout MATCHES "\nunit_value:\n")
    message(FATAL_ERROR "-S -o - wrote no assembly\n${stdout}")
endif()
run(preprocessed 0 "${CC}" -E unit.x -o -)
if(NOT stdout MATCHES "global i32 unit_value")
    message(FATAL_ERROR "-E -o - wrote no source\n${stdout}")
endif()
run(cpp 0 "${CPP}" unit.x -o -)
if(NOT stdout MATCHES "global i32 unit_value")
    message(FATAL_ERROR "cpp -o - wrote no source\n${stdout}")
endif()
run(rules 0 "${CC}" -M unit.x -o -)
if(NOT stdout MATCHES "^unit[.]o: unit[.]x")
    message(FATAL_ERROR "-M -o - wrote no rule\n${stdout}")
endif()
run(rule_file 0 "${CC}" -S ${target} -MD -MF - unit.x -o unit.s)
if(NOT stdout MATCHES "^unit[.]s: unit[.]x")
    message(FATAL_ERROR "-MF - wrote no rule\n${stdout}")
endif()
run(beside 0 "${CC}" -S ${target} -fstack-usage -MD unit.x -o -)
if(NOT EXISTS "${OUTPUT}/unit.su" OR NOT EXISTS "${OUTPUT}/unit.d")
    message(FATAL_ERROR "-o - did not write unit.su and unit.d beside the input")
endif()
file(READ "${OUTPUT}/unit.d" rule)
if(NOT rule MATCHES "^unit[.]o: unit[.]x")
    message(FATAL_ERROR "-MD -o - wrote the wrong rule\n${rule}")
endif()
run(object 1 "${CC}" -c ${target} unit.x -o -)
if(NOT stderr MATCHES "cc: error: an object file cannot be written to standard output")
    message(FATAL_ERROR "-c -o - was not diagnosed\n${stderr}")
endif()
if(EXISTS "${OUTPUT}/-")
    message(FATAL_ERROR "a file named '-' was written")
endif()
