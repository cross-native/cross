        .set noreorder
        .set noat
        .set mips3
        .section .text.boot,"ax",@progbits
        .globl _start
_start:
        lui $29,0x8080
        addiu $29,$29,-64
        mfc0 $8,$12
        lui $9,@STATUS_BITS@
        or $8,$8,$9
        mtc0 $8,$12
        nop
        nop
        # Independent, hand-written ABI caller. Object bytes are loaded in
        # address order, so the same oracle covers both target endians.
        .if @ORACLE@
        lui $12,%hi(.Lpair)
        addiu $12,$12,%lo(.Lpair)
        .if @O32@
        addiu $4,$29,32
        lw $5,0($12)
        lw $6,4($12)
        addiu $7,$0,7
        .else
        ld $4,0($12)
        addiu $5,$0,7
        .endif
        jal pair_step
        nop
        .if @O32@
        addiu $12,$29,32
        bne $2,$12,.Loraclefail
        nop
        .else
        sd $2,32($29)
        .endif
        lw $12,32($29)
        li $13,0x1122334b
        bne $12,$13,.Loraclefail
        nop
        lw $12,36($29)
        li $13,0x475221f0
        bne $12,$13,.Loraclefail
        nop

        lui $12,%hi(.Ltiny)
        addiu $12,$12,%lo(.Ltiny)
        .if @O32@
        addiu $4,$29,32
        lw $5,0($12)
        .else
        ld $4,0($12)
        .endif
        jal tiny_step
        nop
        .if !@O32@
        sd $2,32($29)
        .endif
        lbu $12,32($29)
        addiu $13,$0,18
        bne $12,$13,.Loraclefail
        nop
        lbu $12,33($29)
        addiu $13,$0,67
        bne $12,$13,.Loraclefail
        nop
        lbu $12,34($29)
        addiu $13,$0,132
        bne $12,$13,.Loraclefail
        nop

        lui $12,%hi(.Lfloats)
        addiu $12,$12,%lo(.Lfloats)
        .if @O32@
        addiu $4,$29,32
        lw $5,0($12)
        lw $6,4($12)
        lw $7,8($12)
        lw $13,12($12)
        sw $13,16($29)
        .else
        ldc1 $f12,0($12)
        ldc1 $f13,8($12)
        .endif
        jal float_step
        nop
        .if !@O32@
        sdc1 $f0,32($29)
        sdc1 $f2,40($29)
        .endif
        lui $12,%hi(.Lfloats_expected)
        addiu $12,$12,%lo(.Lfloats_expected)
        ld $13,0($12)
        ld $14,32($29)
        bne $13,$14,.Loraclefail
        nop
        ld $13,8($12)
        ld $14,40($29)
        bne $13,$14,.Loraclefail
        nop
        .endif
        addiu $4,$0,17
        jal aggregate_test
        nop
        addiu $12,$0,1
        bne $2,$12,.Lfail
        nop
        addiu $4,$0,18
        jal aggregate_test
        nop
        addiu $12,$0,1
        bne $2,$12,.Lfail
        nop
        addiu $4,$0,'P'
        b .Lreport
        nop
.Loraclefail:
        addiu $2,$0,14
.Lfail:
        addiu $4,$2,'A'
.Lreport:
        lui $12,0xbf00
        ori $12,$12,0x0900
        sb $4,0($12)
        addiu $4,$0,'\n'
        sb $4,0($12)
        move $4,$0
        addiu $2,$0,1
        addiu $25,$0,1
        .word 0x7000007f
.Lhalt:
        b .Lhalt
        nop
        .section .rodata
        .p2align 3
.Lpair:
        .word 0x11223344,0x55667788
.Ltiny:
        .byte 17,65,129,0,0,0,0,0
.Lfloats:
        .double 1.25,7.5
.Lfloats_expected:
        .double 2.25,9.5
