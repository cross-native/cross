#
# Differential linking against GNU ld: the `cc -c -g` objects of every
# shipped MIPS profile, linked with the repository's bare-metal scripts by
# GNU ld and by the Cross ld, give the same header flags, the same section
# names, types, addresses, sizes, and contents (debugging sections
# included), and the same symbols.

foreach(required CC LD SOURCES OUTPUT)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "${required} must name a path")
    endif()
endforeach()
find_program(GNU_LD NAMES mips64-elf-ld)
find_program(LLVM_OBJCOPY NAMES llvm-objcopy)
find_program(LLVM_READELF NAMES llvm-readelf)
find_program(LLVM_NM NAMES llvm-nm)
if(NOT GNU_LD OR NOT LLVM_OBJCOPY OR NOT LLVM_READELF OR NOT LLVM_NM)
    message(STATUS "skipping the GNU ld comparison: mips64-elf-ld and the LLVM tools are required")
    return()
endif()
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/../../../.." ABSOLUTE)
file(REMOVE_RECURSE "${OUTPUT}")
file(MAKE_DIRECTORY "${OUTPUT}")

function(run_checked label)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE status OUTPUT_VARIABLE stdout
                    ERROR_VARIABLE stderr)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "${label} failed\n${stdout}\n${stderr}")
    endif()
    set(stdout "${stdout}" PARENT_SCOPE)
endfunction()

# The sections of an image as "name type address size" lines, without the
# tables every linker writes its own way.
function(section_lines image result)
    run_checked("sections of ${image}" "${LLVM_READELF}" -S --wide "${image}")
    string(REPLACE "\n" ";" rows "${stdout}")
    set(lines "")
    foreach(row IN LISTS rows)
        if(NOT row MATCHES "^ +\\[ *[1-9][0-9]*\\] ")
            continue()
        endif()
        string(REGEX REPLACE "^ +\\[ *[0-9]+\\] +" "" rest "${row}")
        string(REGEX REPLACE " +" ";" fields "${rest}")
        list(GET fields 0 name)
        list(GET fields 1 type)
        list(GET fields 2 address)
        list(GET fields 4 size)
        if(NOT name MATCHES "^[.](symtab|strtab|shstrtab)$")
            list(APPEND lines "${name} ${type} ${address} ${size}")
        endif()
    endforeach()
    set(${result} "${lines}" PARENT_SCOPE)
endfunction()

execute_process(COMMAND "${CC}" --print-profiles OUTPUT_VARIABLE listing)
string(REGEX MATCHALL "\n([^ \n]+)  target: mips" matches "\n${listing}")
set(profiles "")
foreach(match IN LISTS matches)
    string(REGEX REPLACE "\n([^ ]+)  target: mips" "\\1" profile "${match}")
    list(APPEND profiles "${profile}")
endforeach()
set(compared 0)
foreach(profile IN LISTS profiles)
    foreach(source IN LISTS SOURCES)
        get_filename_component(stem "${source}" NAME_WE)
        set(base "${OUTPUT}/${profile}.${stem}")
        run_checked("${profile} ${stem}" "${CC}" -c -O2 -g -mprofile=${profile} "${source}" -o "${base}.o")
        run_checked("header" "${LLVM_READELF}" --file-headers "${base}.o")
        set(endian -EB)
        set(format "")
        if(stdout MATCHES "DataEncoding: LittleEndian|little endian")
            set(endian -EL)
        endif()
        set(script "${root}/test/target/mips/bare.ld")
        if(stdout MATCHES "Class: +ELF64")
            set(script "${root}/test/target/mips/bare-n64.ld")
            set(format --oformat=elf64-bigmips)
            if(endian STREQUAL "-EL")
                set(format --oformat=elf64-littlemips)
            endif()
        endif()
        set(arguments ${endian} ${format} -T "${script}" -e 0 "${base}.o")
        run_checked("GNU ld ${profile} ${stem}" "${GNU_LD}" ${arguments} -o "${base}.gnu.elf")
        run_checked("Cross ld ${profile} ${stem}" "${LD}" ${arguments} -o "${base}.cross.elf")
        foreach(linker gnu cross)
            run_checked("flags" "${LLVM_READELF}" --file-headers "${base}.${linker}.elf")
            string(REGEX MATCH "Flags: [^\n]*" ${linker}_flags "${stdout}")
            section_lines("${base}.${linker}.elf" ${linker}_sections)
            run_checked("symbols" "${LLVM_NM}" --format=posix "${base}.${linker}.elf")
            set(${linker}_symbols "${stdout}")
        endforeach()
        if(NOT gnu_flags STREQUAL cross_flags OR NOT gnu_sections STREQUAL cross_sections OR
           NOT gnu_symbols STREQUAL cross_symbols)
            message(FATAL_ERROR "${profile} ${stem}: the images differ\nGNU ld: ${gnu_flags}\n${gnu_sections}\n${gnu_symbols}\nCross ld: ${cross_flags}\n${cross_sections}\n${cross_symbols}")
        endif()
        foreach(line IN LISTS cross_sections)
            string(REPLACE " " ";" fields "${line}")
            list(GET fields 0 name)
            list(GET fields 1 type)
            if(type STREQUAL "NOBITS")
                continue()
            endif()
            foreach(linker gnu cross)
                run_checked("dump ${name}" "${LLVM_OBJCOPY}" "--dump-section=${name}=${base}.${linker}${name}"
                            "${base}.${linker}.elf" "${base}.${linker}.copy")
                file(READ "${base}.${linker}${name}" ${linker}_bytes HEX)
            endforeach()
            if(NOT gnu_bytes STREQUAL cross_bytes)
                message(FATAL_ERROR "${profile} ${stem}: ${name} differs from GNU ld's")
            endif()
        endforeach()
        math(EXPR compared "${compared} + 1")
    endforeach()
endforeach()
message(STATUS "Cross ld and GNU ld agree on ${compared} images")
