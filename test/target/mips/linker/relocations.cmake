#
# MIPS relocations in o32 (REL) and n64 (RELA) objects of both byte orders:
# the linked words match the values computed from the symbol addresses and,
# when mips64-elf-ld is available, GNU ld's image byte for byte; with
# mips64-elf-as, also the relocations only GNU as emits.

include("${CMAKE_CURRENT_LIST_DIR}/common.cmake")
if(LINKER_TEST_SKIP)
    return()
endif()
set(sources "${CMAKE_CURRENT_LIST_DIR}")

# The low 32 bits of VALUE (an expression) as eight hexadecimal digits.
function(word value result)
    math(EXPR number "(${value}) & 0xffffffff" OUTPUT_FORMAT HEXADECIMAL)
    string(SUBSTRING "${number}" 2 -1 digits)
    string(LENGTH "${digits}" length)
    while(length LESS 8)
        string(PREPEND digits "0")
        math(EXPR length "${length} + 1")
    endwhile()
    set(${result} "${digits}" PARENT_SCOPE)
endfunction()

function(expect_word label words index value)
    list(GET words ${index} actual)
    word("${value}" expected)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "${label}: word ${index} is ${actual}, expected ${expected}\n${words}")
    endif()
endfunction()

foreach(variant o32-big o32-little n64-big n64-little n64-high)
    string(REPLACE "-" ";" fields "${variant}")
    list(GET fields 0 abi)
    list(GET fields 1 order)
    set(start 0x80100000)
    set(endian -EB)
    set(gnu_format "")
    if(abi STREQUAL "o32")
        set(as_abi -mabi=32)
        set(triple mips-unknown-elf)
        if(order STREQUAL "little")
            set(triple mipsel-unknown-elf)
        endif()
    else()
        set(as_abi -mabi=64)
        set(triple mips64-unknown-elf)
        set(start 0xffffffff80100000)
        set(gnu_format --oformat=elf64-bigmips)
        if(order STREQUAL "high")
            set(order big)
            set(start 0x0000123480100000)
        elseif(order STREQUAL "little")
            set(triple mips64el-unknown-elf)
            set(gnu_format --oformat=elf64-littlemips)
        endif()
    endif()
    if(order STREQUAL "little")
        set(endian -EL)
    endif()
    set(base "${OUTPUT}/${variant}")
    run_checked("${variant} source" "${AS}" -target ${triple} ${as_abi} "${sources}/relocations_${abi}.s"
                -o "${base}.o")
    run_checked("${variant} target" "${AS}" -target ${triple} ${as_abi} "${sources}/relocations_target.s"
                -o "${base}-target.o")
    set(arguments -T "${sources}/relocations.ld" --defsym TEXT_START=${start}
                  --defsym half_value=0x1234 "${base}.o" "${base}-target.o")
    run_checked("${variant} link" "${LD}" ${arguments} -o "${base}.elf")
    if(GNU_LD)
        run_checked("${variant} GNU ld" "${GNU_LD}" ${endian} ${gnu_format} ${arguments} -o "${base}-gnu.elf")
        foreach(section .text .data .sdata)
            section_hex("${base}.elf" ${section} cross)
            section_hex("${base}-gnu.elf" ${section} gnu)
            if(NOT cross STREQUAL gnu)
                message(FATAL_ERROR "${variant} ${section}: Cross ld wrote\n${cross}\nGNU ld\n${gnu}")
            endif()
        endforeach()
    endif()
    if(variant MATCHES "^n64-(big|little)$")
        continue()
    endif()
    foreach(name _start table far_function elsewhere small _gp)
        symbol_value("${base}.elf" ${name} value)
        set(${name} 0x${value})
    endforeach()
    section_words("${base}.elf" .text ${order} text)
    section_words("${base}.elf" .data ${order} data)
    if(abi STREQUAL "o32")
        expect_word(${variant} "${text}" 0 "0x3c020000 | (((${table} + 0x8010 + 0x8000) >> 16) & 0xffff)")
        expect_word(${variant} "${text}" 1 "0x3c030000 | (((${table} + 0x8010 + 0x8000) >> 16) & 0xffff)")
        expect_word(${variant} "${text}" 2 "0x24420000 | ((${table} + 0x8010) & 0xffff)")
        expect_word(${variant} "${text}" 3 "0x8f840000 | ((${small} - ${_gp}) & 0xffff)")
        expect_word(${variant} "${text}" 5 "0x0c000000 | ((${far_function} >> 2) & 0x3ffffff)")
        expect_word(${variant} "${text}" 7 "0x10000000 | (((${elsewhere} - ${_start} - 32) >> 2) & 0xffff)")
        expect_word(${variant} "${data}" 0 "${far_function} + 4")
        expect_word(${variant} "${data}" 1 "${table} + 0x10000")
    else()
        set(address "(${table} + 0x18000)")
        expect_word(${variant} "${text}" 0 "0x3c020000 | (((${address} + 0x800080008000) >> 48) & 0xffff)")
        expect_word(${variant} "${text}" 1 "0x64420000 | (((${address} + 0x80008000) >> 32) & 0xffff)")
        expect_word(${variant} "${text}" 3 "0x64420000 | (((${address} + 0x8000) >> 16) & 0xffff)")
        expect_word(${variant} "${text}" 5 "0x64420000 | (${address} & 0xffff)")
        expect_word(${variant} "${text}" 6 "0x8f840000 | ((${small} - ${_gp}) & 0xffff)")
        expect_word(${variant} "${text}" 7 "0x0c000000 | ((${far_function} >> 2) & 0x3ffffff)")
        expect_word(${variant} "${text}" 9 "0x10000000 | (((${elsewhere} - ${_start} - 40) >> 2) & 0xffff)")
        expect_word(${variant} "${data}" 0 "(${far_function} + 8) >> 32")
        expect_word(${variant} "${data}" 1 "${far_function} + 8")
        expect_word(${variant} "${data}" 2 "(${table} + 0x10000) >> 32")
        expect_word(${variant} "${data}" 3 "${table} + 0x10000")
        expect_word(${variant} "${data}" 4 "0x1234")
    endif()
endforeach()

# R_MIPS_LITERAL and R_MIPS_GPREL32 from GNU as, against GNU ld.
find_program(GNU_AS NAMES mips64-elf-as)
if(GNU_AS AND GNU_LD)
    set(script "${OUTPUT}/gnu.ld")
    file(WRITE "${script}" "ENTRY(_start)\nSECTIONS {\n  . = 0x80100000;\n  .text : { *(.text) }\n  .rodata : { *(.rodata .rdata) }\n  _gp = ALIGN(16) + 0x7ff0;\n  .lit8 : { *(.lit8) }\n  .lit4 : { *(.lit4) }\n  /DISCARD/ : { *(.reginfo) *(.MIPS.abiflags) *(.pdr) *(.gnu.attributes) }\n}\n")
    foreach(mode literal gpword)
        if(mode STREQUAL "literal")
            set(options -G 8)
            set(type R_MIPS_LITERAL)
        else()
            set(options -KPIC)
            set(type R_MIPS_GPREL32)
        endif()
        set(base "${OUTPUT}/gnu-${mode}")
        run_checked("GNU as ${mode}" "${GNU_AS}" -EB -32 -march=mips2 ${options}
                    "${sources}/relocations_${mode}.s" -o "${base}.o")
        run_checked("relocations" "${LLVM_READELF}" -r "${base}.o")
        expect("GNU as ${mode}" "${run_stdout}" "${type}")
        run_checked("GNU ld ${mode}" "${GNU_LD}" -T "${script}" "${base}.o" -o "${base}-gnu.elf")
        run_checked("Cross ld ${mode}" "${LD}" -T "${script}" "${base}.o" -o "${base}.elf")
        foreach(section .text .rodata .lit8 .lit4)
            section_hex("${base}.elf" ${section} cross)
            section_hex("${base}-gnu.elf" ${section} gnu)
            if(NOT cross STREQUAL gnu)
                message(FATAL_ERROR "${mode} ${section}: Cross ld wrote ${cross}, GNU ld ${gnu}")
            endif()
        endforeach()
    endforeach()
endif()
