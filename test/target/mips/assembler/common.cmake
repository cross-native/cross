# Helpers shared by the MIPS assembler tests.

if(DEFINED OUTPUT)
    get_filename_component(output_directory "${OUTPUT}" DIRECTORY)
    file(MAKE_DIRECTORY "${output_directory}")
endif()
find_program(LLVM_OBJCOPY NAMES llvm-objcopy)
find_program(LLVM_READELF NAMES llvm-readelf)
if(NOT LLVM_OBJCOPY OR NOT LLVM_READELF)
    message(STATUS "skipping assembler test: llvm-objcopy and llvm-readelf are required")
    set(ASSEMBLER_TEST_SKIP TRUE)
endif()

function(run_checked label)
    execute_process(COMMAND ${ARGN}
                    RESULT_VARIABLE status
                    OUTPUT_VARIABLE stdout
                    ERROR_VARIABLE stderr)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "${label} failed\n${stdout}\n${stderr}")
    endif()
endfunction()

# The four-byte words of an object's section as lowercase hexadecimal, read
# in the object's byte order.
function(section_words object section order result)
    run_checked("extract ${section}" "${LLVM_OBJCOPY}"
                --dump-section=${section}=${object}${section}.bin "${object}"
                "${object}.copy")
    file(READ "${object}${section}.bin" hex HEX)
    string(LENGTH "${hex}" length)
    set(words "")
    set(index 0)
    while(index LESS length)
        string(SUBSTRING "${hex}" ${index} 8 word)
        if(order STREQUAL "little")
            string(SUBSTRING "${word}" 0 2 b0)
            string(SUBSTRING "${word}" 2 2 b1)
            string(SUBSTRING "${word}" 4 2 b2)
            string(SUBSTRING "${word}" 6 2 b3)
            set(word "${b3}${b2}${b1}${b0}")
        endif()
        list(APPEND words "${word}")
        math(EXPR index "${index} + 8")
    endwhile()
    set(${result} "${words}" PARENT_SCOPE)
endfunction()

function(text_words object order result)
    section_words("${object}" .text ${order} words)
    set(${result} "${words}" PARENT_SCOPE)
endfunction()

# The words an assembly file's instruction comments list, in order.
function(commented_words source result)
    file(STRINGS "${source}" lines)
    set(words "")
    foreach(line IN LISTS lines)
        if(line MATCHES "^[ \t]+[a-z].*#[ ]*([0-9a-f ]+)$")
            string(REPLACE " " ";" each "${CMAKE_MATCH_1}")
            list(APPEND words ${each})
        endif()
    endforeach()
    set(${result} "${words}" PARENT_SCOPE)
endfunction()

# Relocations as "section offset type symbol[ + addend]" lines.
function(relocation_lines object result)
    execute_process(COMMAND "${LLVM_READELF}" -r --wide "${object}"
                    RESULT_VARIABLE status OUTPUT_VARIABLE text ERROR_VARIABLE error)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "cannot read the relocations of ${object}\n${error}")
    endif()
    string(REPLACE ";" "," text "${text}")
    string(REPLACE "\n" ";" text_lines "${text}")
    set(lines "")
    foreach(line IN LISTS text_lines)
        if(line MATCHES "^Relocation section '([^']+)'")
            set(section "${CMAKE_MATCH_1}")
        elseif(line MATCHES "^ *([0-9a-f]+) +[0-9a-f]+ +(R_MIPS_[A-Z0-9_/]+) +[0-9a-f]+ +(.*)$")
            set(offset "${CMAKE_MATCH_1}")
            set(type "${CMAKE_MATCH_2}")
            set(target "${CMAKE_MATCH_3}")
            string(REGEX REPLACE "^0+(.)" "\\1" offset "${offset}")
            string(REPLACE "/R_MIPS_NONE" "" type "${type}")
            list(APPEND lines "${section} ${offset} ${type} ${target}")
        endif()
    endforeach()
    set(${result} "${lines}" PARENT_SCOPE)
endfunction()

function(expect_lines label actual expected)
    if(NOT "${actual}" STREQUAL "${expected}")
        string(REPLACE ";" "\n  " shown_actual "${actual}")
        string(REPLACE ";" "\n  " shown_expected "${expected}")
        message(FATAL_ERROR "${label} differ\nexpected:\n  ${shown_expected}\nactual:\n  ${shown_actual}")
    endif()
endfunction()

# The facts two assemblers' objects of one source must share, as sorted
# lines: each section's type, flags, alignment, entry size, size, and
# contents; the relocations of each section in order; and each symbol other
# than section symbols, with its section by name. Section and symbol order,
# string tables, and file offsets are left out.
function(object_facts object result)
    execute_process(COMMAND "${LLVM_READELF}" -S --wide "${object}"
                    RESULT_VARIABLE status OUTPUT_VARIABLE text ERROR_VARIABLE error)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "cannot read the sections of ${object}\n${error}")
    endif()
    string(REPLACE ";" "," text "${text}")
    string(REPLACE "\n" ";" text_lines "${text}")
    set(facts "")
    set(names "")
    foreach(line IN LISTS text_lines)
        if(NOT line MATCHES "^ *\\[ *([0-9]+)\\] ([^ ]*) +([A-Za-z_0-9]+) +[0-9a-f]+ [0-9a-f]+ ([0-9a-f]+) ([0-9a-f]+) (.*) +[0-9]+ +[0-9]+ +([0-9]+)$")
            continue()
        endif()
        set(index "${CMAKE_MATCH_1}")
        set(name "${CMAKE_MATCH_2}")
        set(type "${CMAKE_MATCH_3}")
        set(size "${CMAKE_MATCH_4}")
        set(entry "${CMAKE_MATCH_5}")
        string(STRIP "${CMAKE_MATCH_6}" flags)
        set(alignment "${CMAKE_MATCH_7}")
        set(section_${index} "${name}")
        if(type MATCHES "^(NULL|SYMTAB|STRTAB|REL|RELA)$")
            continue()
        endif()
        set(contents "")
        if(NOT type STREQUAL "NOBITS" AND NOT size MATCHES "^0+$")
            execute_process(COMMAND "${LLVM_OBJCOPY}" "--dump-section=${name}=${object}.section"
                                    "${object}" "${object}.copy" RESULT_VARIABLE status)
            if(status EQUAL 0)
                file(READ "${object}.section" contents HEX)
            endif()
        endif()
        list(APPEND facts "section ${name} ${type} ${flags} align ${alignment} entry ${entry} size ${size} ${contents}")
    endforeach()
    relocation_lines("${object}" relocations)
    list(APPEND facts ${relocations})
    execute_process(COMMAND "${LLVM_READELF}" -s --wide "${object}" OUTPUT_VARIABLE text)
    string(REPLACE ";" "," text "${text}")
    string(REPLACE "\n" ";" text_lines "${text}")
    foreach(line IN LISTS text_lines)
        if(line MATCHES "^ *[0-9]+: ([0-9a-f]+) +([0-9]+) ([A-Z_]+) +([A-Z]+) +([A-Z]+) +([A-Z0-9]+) ?(.*)$")
            if(CMAKE_MATCH_3 STREQUAL "SECTION" OR CMAKE_MATCH_7 STREQUAL "")
                continue()
            endif()
            set(where "${CMAKE_MATCH_6}")
            if(DEFINED section_${where})
                set(where "${section_${where}}")
            endif()
            list(APPEND facts "symbol ${CMAKE_MATCH_7} ${CMAKE_MATCH_1} ${CMAKE_MATCH_2} ${CMAKE_MATCH_3} ${CMAKE_MATCH_4} ${CMAKE_MATCH_5} ${where}")
        endif()
    endforeach()
    list(SORT facts)
    set(${result} "${facts}" PARENT_SCOPE)
endfunction()

# GNU_AS when installed; compare_with_gnu(LABEL SOURCE "AS-OPTIONS"
# "GNU-OPTIONS") assembles SOURCE with both and requires the same facts.
find_program(GNU_AS NAMES mips64-elf-as)
function(compare_with_gnu label source cross_options gnu_options)
    if(NOT GNU_AS)
        return()
    endif()
    separate_arguments(cross_options UNIX_COMMAND "${cross_options}")
    separate_arguments(gnu_options UNIX_COMMAND "${gnu_options}")
    string(MAKE_C_IDENTIFIER "${label}" stem)
    set(cross_object "${OUTPUT}.${stem}.cross.o")
    set(gnu_object "${OUTPUT}.${stem}.gnu.o")
    run_checked("${label} (as)" "${AS}" ${cross_options} "${source}" -o "${cross_object}")
    run_checked("${label} (GNU as)" "${GNU_AS}" ${gnu_options} "${source}" -o "${gnu_object}")
    object_facts("${cross_object}" cross)
    object_facts("${gnu_object}" gnu)
    expect_lines("${label}: facts of as and GNU as" "${cross}" "${gnu}")
endfunction()
