set(base "${OUTPUT}")
set(STARTUP "${base}-start.s")
set(EXPECTED P)
set(MEMBERS_SOURCE "${CMAKE_CURRENT_LIST_DIR}/../../middle/aggregate_members.x")
set(BITFIELD_SOURCE
    "${CMAKE_CURRENT_LIST_DIR}/../../backend/native/aggregate/bitfield_runtime.x")
foreach(kind size bank)
    execute_process(COMMAND "${CC}" -target mips-unknown-elf -march=vr4300 -mabi=o32
        -O2 -S "${CMAKE_CURRENT_LIST_DIR}/aggregate_${kind}_error.x"
        -o "${base}-${kind}-error.s" RESULT_VARIABLE status ERROR_VARIABLE error)
    if(kind STREQUAL size)
        set(expected_error "complete records through 8191 bytes")
    else()
        set(expected_error "MIPS ABI model could not classify function interface")
    endif()
    if(status EQUAL 0 OR NOT error MATCHES "${expected_error}")
        message(FATAL_ERROR "aggregate ${kind} diagnostic mismatch: ${error}")
    endif()
endforeach()
foreach(level O0 O2 O3 Oz)
    foreach(private private-abi no-private-abi)
        foreach(ABI o32 cross32 eabi32 cross64)
            set(ORACLE 0)
            set(O32 1)
            if(ABI STREQUAL o32)
                set(ORACLE 1)
            endif()
            set(MIPS_CPUS vr4300 r3000)
            if(ABI STREQUAL cross64)
                set(MIPS_CPUS vr4300)
            endif()
            set(STATUS_BITS 0x2000)
            configure_file("${CMAKE_CURRENT_LIST_DIR}/aggregate_start.s.in" "${STARTUP}" @ONLY)
            set(SOURCE "${base}-${ABI}.x")
            configure_file("${CMAKE_CURRENT_LIST_DIR}/aggregate.x.in" "${SOURCE}" @ONLY)
            set(OUTPUT "${base}-${ABI}-${level}-${private}")
            set(CC_FLAGS -${level} -f${private})
            include("${CMAKE_CURRENT_LIST_DIR}/../../language/semantics/mips.cmake")
        endforeach()
        foreach(ABI n64)
            set(ORACLE 1)
            set(O32 0)
            set(STATUS_BITS 0x2400)
            configure_file("${CMAKE_CURRENT_LIST_DIR}/aggregate_start.s.in" "${STARTUP}" @ONLY)
            set(SOURCE "${base}-${ABI}.x")
            configure_file("${CMAKE_CURRENT_LIST_DIR}/aggregate.x.in" "${SOURCE}" @ONLY)
            set(EXTRA_FLAGS "-${level} -f${private}")
            set(LINKER "${CMAKE_CURRENT_LIST_DIR}/bare-n64.ld")
            foreach(N64_ENDIAN big little)
                set(OUTPUT "${base}-${ABI}-${level}-${private}-${N64_ENDIAN}")
                include("${CMAKE_CURRENT_LIST_DIR}/n64_runtime.cmake")
            endforeach()
        endforeach()
    endforeach()
endforeach()
