foreach(mode O2 O3 no-fold no-fusion)
    set(flags -O2)
    if(mode STREQUAL "O3")
        set(flags -O3)
    elseif(mode STREQUAL "no-fold")
        list(APPEND flags -fno-fold-memory-operands)
    elseif(mode STREQUAL "no-fusion")
        list(APPEND flags -fno-compare-branch-fusion)
    endif()
    execute_process(COMMAND "${CC}" -S ${flags} -fno-eval-calls
        -target x86_64-unknown-linux-gnu "${SOURCE}" -o "${OUTPUT}-${mode}.s"
        RESULT_VARIABLE status ERROR_VARIABLE error)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "narrow-load compilation failed: ${error}")
    endif()
    file(READ "${OUTPUT}-${mode}.s" assembly)
    function(body name)
        string(FIND "${assembly}" "${name}:" start)
        string(SUBSTRING "${assembly}" ${start} -1 tail)
        string(FIND "${tail}" ".size ${name}," length)
        string(SUBSTRING "${tail}" 0 ${length} found)
        set(found "${found}" PARENT_SCOPE)
    endfunction()
    if(mode MATCHES "^O")
        foreach(name prefix prefix16 prefix_nonzero hash8 offset_load repeated_load)
            body(${name})
            if(found MATCHES "\tnop([\t\n]|$)")
                message(FATAL_ERROR "${name} contains an unremoved extension\n${found}")
            endif()
        endforeach()
        body(offset_load)
        if(NOT found MATCHES "\tmovzbl\t2\\([^\n]*,[^\n]*\\)," OR
           found MATCHES "\t(addq|leaq)\t")
            message(FATAL_ERROR "extending load lost indexed displacement folding\n${found}")
        endif()
        body(hash8)
        if(NOT found MATCHES "\tmovzbl\t\\([^\n]*,[^\n]*\\)," OR
           found MATCHES "\tpushq\t")
            message(FATAL_ERROR "hash loop lost indexed addressing or acquired saves\n${found}")
        endif()
        body(repeated_load)
        string(REGEX MATCHALL "\tmovzbl\t[^\n]*\\(" loads "${found}")
        list(LENGTH loads load_count)
        if(NOT load_count EQUAL 1)
            message(FATAL_ERROR "redundant narrow load survived\n${found}")
        endif()
        foreach(name prefix prefix16 prefix_nonzero)
            body(${name})
            if(found MATCHES "\tset[a-z]+\t" OR
               NOT found MATCHES "\tcmp[bw]\t[^\n]*\\(")
                message(FATAL_ERROR "${name} lost its memory compare or direct branch\n${found}")
            endif()
        endforeach()
        foreach(type u8 u16 i8 i16)
            foreach(width 32 64)
                body(load_${type}_${width})
                if(NOT found MATCHES "\tmov[sz][bw][lq]\t[^\n]*\\(" OR
                   found MATCHES "\tmov[bw]\t[^\n]*\\(")
                    message(FATAL_ERROR "load_${type}_${width} did not extend in memory\n${found}")
                endif()
            endforeach()
        endforeach()
    elseif(mode STREQUAL "no-fold")
        body(prefix)
        if(found MATCHES "\tcmpb\t[^\n]*\\(")
            message(FATAL_ERROR "memory folding ignored its control\n${found}")
        endif()
    endif()
endforeach()
