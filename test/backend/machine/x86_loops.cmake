foreach(required CC SOURCE OUTPUT)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "${required} must name a path")
    endif()
endforeach()
function(compile name)
    execute_process(COMMAND "${CC}" -S -target x86_64-unknown-linux-gnu
        -O2 -fno-eval-calls ${ARGN} "${SOURCE}" -o "${OUTPUT}-${name}.s"
        RESULT_VARIABLE result ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "${name}: ${error}")
    endif()
    file(READ "${OUTPUT}-${name}.s" assembly)
    set(${name} "${assembly}" PARENT_SCOPE)
endfunction()
function(body assembly name output)
    string(REGEX MATCH "\n${name}:\n[^@]*[.]size ${name}," found "${assembly}")
    if(found STREQUAL "")
        message(FATAL_ERROR "missing ${name}")
    endif()
    set(${output} "${found}" PARENT_SCOPE)
endfunction()
compile(on)
compile(branches -fno-if-conversion)
compile(no_cprop -fno-cprop-registers)
compile(no_combine -fno-machine-combine)
compile(no_peephole -fno-peephole2)
compile(no_fusion -fno-compare-branch-fusion)
compile(size -Oz)
# Forward phi copies must disappear from the decoder's common edge.
string(REGEX MATCH "[A-Za-z0-9_]+_decode" decoder "${on}")
body("${on}" ${decoder} code)
if(code MATCHES "edge[.]stub")
    message(FATAL_ERROR "decoder still has a phi-copy stub")
endif()
body("${no_cprop}" ${decoder} code)
if(NOT code MATCHES "edge[.]stub")
    message(FATAL_ERROR "-fno-cprop-registers did not restore phi copies")
endif()
foreach(name extend_signed extend_mask extend_signbit)
    body("${on}" ${name} code)
    if(name STREQUAL "extend_mask")
        if(code MATCHES "movslq")
            message(FATAL_ERROR "nonnegative mask still sign extends")
        endif()
    elseif(NOT code MATCHES "movslq")
        message(FATAL_ERROR "${name} must sign extend")
    endif()
endforeach()
body("${no_combine}" extend_mask code)
if(NOT code MATCHES "movslq")
    message(FATAL_ERROR "-fno-machine-combine did not restore sign extension")
endif()
body("${no_peephole}" extend_signed code)
if(NOT code MATCHES "movl[^\n]*\n\tmovslq")
    message(FATAL_ERROR "-fno-peephole2 did not restore staged extension")
endif()
body("${on}" extend_signed code)
if(code MATCHES "movl[^\n]*\n\tmovslq")
    message(FATAL_ERROR "register sign extension must read its source directly")
endif()
foreach(width 32 64)
    foreach(cond eq ne slt sge sle sgt ult uge ule ugt)
        body("${on}" flags_${cond}${width} code)
        if(code MATCHES "\tcmp" OR NOT code MATCHES "\tsub[lq]\t\\$17")
            message(FATAL_ERROR "flags_${cond}${width} did not reuse subtraction flags")
        endif()
        body("${no_combine}" flags_${cond}${width} code)
        if(NOT code MATCHES "\tcmp")
            message(FATAL_ERROR "disabled combine did not restore ${cond}${width} compare")
        endif()
    endforeach()
endforeach()

foreach(width 32 64)
    foreach(cond sle sgt ule ugt)
        body("${on}" exact_${cond}${width} code)
        if(code MATCHES "\tcmp" OR NOT code MATCHES "\tset")
            message(FATAL_ERROR "exact ${cond}${width} did not reuse flags")
        endif()
    endforeach()
endforeach()
body("${size}" carry32 code)
if(NOT code MATCHES "\tsubl\t\\$1" OR code MATCHES "\tdecl")
    message(FATAL_ERROR "carry comparison must use SUB, which defines CF")
endif()
body("${branches}" chain_match code)
if(NOT code MATCHES "\tsubl\t\\$1,[^\n]*\n(\tmov[^\n]*\n)*\tj(ge|l)\t")
    message(FATAL_ERROR "chain decrement must branch on SUB flags")
endif()
body("${no_fusion}" chain_match code)
if(NOT code MATCHES "\tsubl\t\\$1,[^\n]*\n\tsetge\t" OR
   NOT code MATCHES "\ttestb\t")
    message(FATAL_ERROR "-fno-compare-branch-fusion must materialize the flag boolean")
endif()

body("${on}" extend_unsigned code)
if(NOT code MATCHES "\tmovl")
    message(FATAL_ERROR "parameter upper bits are unspecified and must be cleared")
endif()

body("${branches}" chain_match code)
if(code MATCHES "\tjbe\t[^\n]*edge[.]stub")
    message(FATAL_ERROR "loop update bypass must copy inline instead of a stub round trip")
endif()

foreach(width 32 64)
    foreach(cond zero negative)
        body("${on}" add_${cond}${width} code)
        if(code MATCHES "\tcmp" OR NOT code MATCHES "\tadd[lq]\t\\$1")
            message(FATAL_ERROR "flag-producing addition must survive address LEA combining")
        endif()
    endforeach()
endforeach()
