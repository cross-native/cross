// 128-bit integers convert to f64 and f32 with one rounding to nearest, ties
// to even: halfway cases, a low word that only breaks a tie, carries into the
// next binade, f32 overflow to infinity, and both signs. Each row holds the
// integer's high and low words and the exact binary64 and binary32 encodings
// of its unsigned and signed readings.

struct int128_float_case {
    u64 high;
    u64 low;
    u64 unsigned_f64;
    u32 unsigned_f32;
    u64 signed_f64;
    u32 signed_f32;
};

union int128_float_f64 { f64 value; u64 bits; };
union int128_float_f32 { f32 value; u32 bits; };

