    {0xcb6ea9f7835ed4a7u64, 0x907b516bc9297e0fu64, 0x47e96dd53ef06bdbu64, 0x7f4b6eaau32, 0xc7ca48ab043e5096u64, 0xfe524558u32},
};

[[noinline]]
static f64 unsigned_to_f64(in u128 value) { return (f64)value; }

[[noinline]]
static f32 unsigned_to_f32(in u128 value) { return (f32)value; }

[[noinline]]
static f64 signed_to_f64(in i128 value) { return (f64)value; }

[[noinline]]
static f32 signed_to_f32(in i128 value) { return (f32)value; }

static u64 f64_bits(in f64 value) {
    union int128_float_f64 bits;
    bits.value = value;
    return bits.bits;
}

static u32 f32_bits(in f32 value) {
    union int128_float_f32 bits;
    bits.value = value;
    return bits.bits;
}

global i32 int128_float_entry() {
    i32 passed = 0;
    for (uptr index = 0uptr; index < 45uptr; index++) {
        u128 value = ((u128)int128_float_cases[index].high << 64u32) |
                     (u128)int128_float_cases[index].low;
        if (f64_bits(unsigned_to_f64(value)) ==
            int128_float_cases[index].unsigned_f64) {
            passed++;
        }
        if (f32_bits(unsigned_to_f32(value)) ==
            int128_float_cases[index].unsigned_f32) {
            passed++;
        }
        if (f64_bits(signed_to_f64((i128)value)) ==
            int128_float_cases[index].signed_f64) {
            passed++;
        }
        if (f32_bits(signed_to_f32((i128)value)) ==
            int128_float_cases[index].signed_f32) {
            passed++;
        }
    }
    return passed;
}
