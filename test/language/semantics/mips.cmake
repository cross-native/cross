foreach(required CC SOURCE STARTUP OUTPUT)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "${required} must name a path")
    endif()
endforeach()
if(NOT DEFINED EXPECTED)
    set(EXPECTED "111")
endif()
find_program(LLVM_MC NAMES llvm-mc)
find_program(LLVM_OBJCOPY NAMES llvm-objcopy)
find_program(LLD NAMES ld.lld)
find_program(QEMU_B NAMES qemu-system-mips64)
find_program(QEMU_L NAMES qemu-system-mips64el)
if(NOT LLVM_MC OR NOT LLVM_OBJCOPY OR NOT LLD)
    message(STATUS "skipping MIPS semantic test: LLVM/QEMU tools are required")
    return()
endif()
# An optional C unit, compiled by Clang, is the independent reference of an
# interoperation test.
if(DEFINED REFERENCE_C AND NOT "${REFERENCE_C}" STREQUAL "")
    find_program(CLANG NAMES clang)
    if(CLANG)
        execute_process(COMMAND "${CLANG}" --print-targets
            OUTPUT_VARIABLE clang_targets ERROR_QUIET)
    endif()
    if(NOT CLANG OR NOT clang_targets MATCHES "mips")
        message(STATUS "skipping MIPS semantic test: Clang with the MIPS target is required")
        return()
    endif()
endif()
get_filename_component(ROOT "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
if(NOT DEFINED MIPS_CPUS)
    set(MIPS_CPUS vr4300 r3000)
endif()
if(NOT DEFINED MIPS_ENDIANS)
    set(MIPS_ENDIANS b l)
endif()
if(MIPS_SINGLE_CASE)
    list(LENGTH MIPS_CPUS cpu_count)
    list(LENGTH MIPS_ENDIANS endian_count)
    if(NOT cpu_count EQUAL 1 OR NOT endian_count EQUAL 1)
        message(FATAL_ERROR "a partitioned MIPS test requires exactly one CPU and byte order")
    endif()
endif()
foreach(endian IN LISTS MIPS_ENDIANS)
    if(NOT endian STREQUAL b AND NOT endian STREQUAL l)
        message(FATAL_ERROR "unknown MIPS endian '${endian}' (expected b or l)")
    endif()
    if(endian STREQUAL "b")
        set(arch mips)
        set(wrapper_arch mips64)
        set(qemu ${QEMU_B})
    else()
        set(arch mipsel)
        set(wrapper_arch mips64el)
        set(qemu ${QEMU_L})
    endif()
    foreach(cpu IN LISTS MIPS_CPUS)
        set(out "${OUTPUT}-${cpu}-${endian}")
        execute_process(COMMAND "${CC}" -target ${arch}-unknown-elf -march=${cpu} -mabi=o32
            -O2 ${CC_FLAGS} -c "${SOURCE}" -o "${out}.o" RESULT_VARIABLE s)
        if(NOT s EQUAL 0)
            message(FATAL_ERROR "MIPS compile failed")
        endif()
        set(objects "${out}.o")
        # An optional second unit, compiled by its own cc invocation.
        if(DEFINED CALLEE_SOURCE AND NOT "${CALLEE_SOURCE}" STREQUAL "")
            execute_process(COMMAND "${CC}" -target ${arch}-unknown-elf -march=${cpu} -mabi=o32
                -O2 ${CC_FLAGS} ${CALLEE_FLAGS} -c "${CALLEE_SOURCE}" -o "${out}.callee.o"
                RESULT_VARIABLE s)
            if(NOT s EQUAL 0)
                message(FATAL_ERROR "MIPS callee compile failed")
            endif()
            list(APPEND objects "${out}.callee.o")
        endif()
        if(DEFINED REFERENCE_C AND NOT "${REFERENCE_C}" STREQUAL "")
            # MIPS II is the oldest ISA whose f64 accesses Clang lowers; -G0
            # keeps data out of the $gp area, which the startups do not set.
            execute_process(COMMAND "${CLANG}" --target=${arch}-unknown-elf -march=mips2
                -mabi=32 -mno-abicalls -fno-pic -G0 -ffreestanding -O2 -c "${REFERENCE_C}"
                -o "${out}.reference.o" RESULT_VARIABLE s)
            if(NOT s EQUAL 0)
                message(FATAL_ERROR "MIPS C reference compile failed")
            endif()
            list(APPEND objects "${out}.reference.o")
        endif()
        execute_process(COMMAND "${LLVM_MC}" --filetype=obj --triple=${arch}-unknown-elf
            --mcpu=mips3 --mattr=+noabicalls,-fp64 "${STARTUP}" -o "${out}.start.o"
            RESULT_VARIABLE s)
        if(NOT s EQUAL 0)
            message(FATAL_ERROR "MIPS startup assembly failed (${cpu}/${endian})")
        endif()
        execute_process(COMMAND "${LLD}" -m elf32${endian}tsmip -T "${ROOT}/test/target/mips/bare.ld"
            "${out}.start.o" ${objects} -o "${out}.elf32" RESULT_VARIABLE s)
        if(NOT s EQUAL 0)
            message(FATAL_ERROR "MIPS link failed")
        endif()
        execute_process(COMMAND "${LLVM_OBJCOPY}" -O binary "${out}.elf32" "${out}.bin" RESULT_VARIABLE s)
        if(NOT s EQUAL 0)
            message(FATAL_ERROR "MIPS image conversion failed (${cpu}/${endian})")
        endif()
        set(IMAGE "${out}.bin")
        configure_file("${ROOT}/test/target/mips/runtime64.s.in" "${out}.wrapper.s" @ONLY)
        execute_process(COMMAND "${LLVM_MC}" --filetype=obj --triple=${wrapper_arch}-unknown-elf
            --mcpu=mips3 "${out}.wrapper.s" -o "${out}.wrapper.o" RESULT_VARIABLE s)
        if(NOT s EQUAL 0)
            message(FATAL_ERROR "MIPS wrapper assembly failed (${cpu}/${endian})")
        endif()
        execute_process(COMMAND "${LLD}" -m elf64${endian}tsmip -T "${ROOT}/test/target/mips/bare64.ld"
            "${out}.wrapper.o" -o "${out}.elf64" RESULT_VARIABLE s)
        if(NOT s EQUAL 0)
            message(FATAL_ERROR "MIPS wrapper link failed (${cpu}/${endian})")
        endif()
        # An orphan/synthetic allocatable section in the transport wrapper can
        # overwrite the original image's NOLOAD storage. Its loadable bytes
        # must remain exactly the original payload, in either byte order.
        execute_process(COMMAND "${LLVM_OBJCOPY}" -O binary "${out}.elf64" "${out}.wrapped.bin"
            RESULT_VARIABLE s)
        if(NOT s EQUAL 0)
            message(FATAL_ERROR "MIPS wrapper image conversion failed (${cpu}/${endian})")
        endif()
        execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files "${out}.bin" "${out}.wrapped.bin"
            RESULT_VARIABLE s)
        if(NOT s EQUAL 0)
            message(FATAL_ERROR "MIPS wrapper changed the loadable payload (${cpu}/${endian})")
        endif()
        if(NOT qemu)
            message(STATUS "skipping MIPS ${cpu}/${endian}: QEMU unavailable")
            continue()
        endif()
        execute_process(COMMAND "${qemu}" -M malta -cpu R4000 -m 64M -bios none
            -kernel "${out}.elf64" -display none -serial none -serial none -serial stdio
            -monitor none -no-reboot -semihosting RESULT_VARIABLE s OUTPUT_VARIABLE o
            ERROR_VARIABLE e TIMEOUT 15)
        string(STRIP "${o}" o)
        if(NOT s EQUAL 0 OR NOT o STREQUAL "${EXPECTED}")
            message(FATAL_ERROR "MIPS result was not ${EXPECTED}\n${o}\n${e}")
        endif()
    endforeach()
endforeach()
