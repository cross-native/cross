foreach(required CC HOST_CXX SOURCE DRIVER OUTPUT)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "${required} must name a path")
    endif()
endforeach()
if(WIN32)
    set(ABI ms_abi)
else()
    set(ABI sysv_abi)
endif()
if(LLVM_TEXT)
    find_program(LLVM_AS NAMES llvm-as)
    if(LLVM_AS)
        execute_process(COMMAND "${CC}" -mabi=${ABI} -O2 -emit-llvm "${SOURCE}"
            -o "${OUTPUT}.ll" RESULT_VARIABLE s OUTPUT_VARIABLE out ERROR_VARIABLE err)
        if(NOT s EQUAL 0)
            message(FATAL_ERROR "semantic LLVM serialization failed\n${out}\n${err}")
        endif()
        execute_process(COMMAND "${LLVM_AS}" "${OUTPUT}.ll" -o "${OUTPUT}.bc"
            RESULT_VARIABLE s OUTPUT_VARIABLE out ERROR_VARIABLE err)
        if(NOT s EQUAL 0)
            message(FATAL_ERROR "semantic LLVM verification failed\n${out}\n${err}")
        endif()
    else()
        message(STATUS "skipping optional semantic LLVM verification: llvm-as unavailable")
    endif()
endif()
foreach(level O0 O1 O2 O3 Os Oz)
    foreach(mode normal noeval)
        set(flags -${level})
        if(mode STREQUAL noeval)
            list(APPEND flags -fno-eval-calls)
        endif()
        set(stem "${OUTPUT}-${level}-${mode}")
        execute_process(COMMAND "${CC}" -mabi=${ABI} ${flags} -c "${SOURCE}" -o "${stem}.o"
            RESULT_VARIABLE s OUTPUT_VARIABLE out ERROR_VARIABLE err)
        if(NOT s EQUAL 0)
            message(FATAL_ERROR "Cross compile failed (${level}/${mode})\n${out}\n${err}")
        endif()
        execute_process(COMMAND "${HOST_CXX}" "${DRIVER}" "${stem}.o" -o "${stem}.exe"
            RESULT_VARIABLE s OUTPUT_VARIABLE out ERROR_VARIABLE err)
        if(NOT s EQUAL 0)
            message(FATAL_ERROR "runtime link failed (${level}/${mode})\n${out}\n${err}")
        endif()
        execute_process(COMMAND "${stem}.exe" RESULT_VARIABLE s)
        if(NOT s EQUAL 0)
            message(FATAL_ERROR "semantic runtime mismatch (${level}/${mode})")
        endif()
    endforeach()
endforeach()
