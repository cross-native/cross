foreach(required CC HOST_CXX SOURCE RUNNER OUTPUT)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "${required} must name a value")
    endif()
endforeach()
foreach(mode normal disabled)
    set(flags -O2 -mabi=ms_abi)
    if(mode STREQUAL disabled)
        list(APPEND flags -fno-jump-tables)
    endif()
    execute_process(COMMAND "${CC}" ${flags} -S "${SOURCE}" -o "${OUTPUT}-${mode}.s"
        RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "switch assembly failed\n${out}\n${err}")
    endif()
    file(READ "${OUTPUT}-${mode}.s" assembly)
    foreach(name dense dense_unreachable dense_assumed conditional_assume)
        string(FIND "${assembly}" "\n${name}:" start)
        if(start LESS 0)
            message(FATAL_ERROR "missing switch function ${name}")
        endif()
        string(SUBSTRING "${assembly}" ${start} -1 body)
        string(FIND "${body}" "\n.text" end)
        if(end GREATER 0)
            string(SUBSTRING "${body}" 0 ${end} body)
        endif()
        if(mode STREQUAL disabled)
            if(body MATCHES "jump.table")
                message(FATAL_ERROR "-fno-jump-tables ignored")
            endif()
        elseif(NOT body MATCHES "jump.table")
            message(FATAL_ERROR "dense switch did not select a jump table")
        elseif(name STREQUAL dense OR name STREQUAL conditional_assume)
            if(NOT body MATCHES "ja[\t ]")
                message(FATAL_ERROR "switch lost its necessary range check: ${name}")
            endif()
        elseif(body MATCHES "ja[\t ]")
            message(FATAL_ERROR "switch retained a redundant range check: ${name}")
        endif()
    endforeach()
endforeach()
foreach(level O0 O2 O3 Os Oz)
    execute_process(COMMAND "${CMAKE_COMMAND}" -DCC=${CC} -DHOST_CXX=${HOST_CXX}
        -DSOURCE=${SOURCE} -DRUNNER=${RUNNER}
        -DOUTPUT=${OUTPUT}-${level} -DENTRY=switch_entry -DEXPECTED=0
        -DCC_FLAGS=-${level} -P "${CMAKE_CURRENT_LIST_DIR}/../../support/run_native.cmake"
        RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "switch runtime failed at ${level}\n${out}\n${err}")
    endif()
endforeach()
